# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 生产构建不使用 vite-plugin-mock；此处仅作占位，请改为实际后端根 URL（或与站点同源的 /）
VITE_USE_MOCK = false

# API 地址前缀（请改为实际后端；与站点同源时可填 / 并由网关转发）
# 说明：本地 Mock 仅在 vite dev 且 VITE_USE_MOCK=true 时生效
VITE_API_URL = http://localhost:3333

# Delete console
VITE_DROP_CONSOLE = true