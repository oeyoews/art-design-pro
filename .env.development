# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 是否使用本地 Mock（true：由 vite-plugin-mock 在 dev 拦截 /api；false：走下方代理）
VITE_USE_MOCK = true

# 代理目标地址（仅当 VITE_USE_MOCK=false 时生效）
# — 真实后端示例：http://127.0.0.1:8080
# — 本地 Nitro 模拟（与 vue-vben-admin backend-mock 同类）：先 pnpm mock:server，再填：
#   http://127.0.0.1:3333
VITE_API_PROXY_URL = http://127.0.0.1:3333

# Delete console
VITE_DROP_CONSOLE = false