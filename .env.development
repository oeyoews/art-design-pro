# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 是否使用本地 Mock（true：由 vite-plugin-mock 在 dev 拦截 /api；false：走下方代理）
VITE_USE_MOCK = true

# 代理目标地址（仅当 VITE_USE_MOCK=false 时生效，填写真实后端或远程 Mock）
VITE_API_PROXY_URL = http://127.0.0.1:8080

# Delete console
VITE_DROP_CONSOLE = false